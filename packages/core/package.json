{
  "name": "finesign-core",
  "version": "0.1.0",
  "description": "The open-source PDF signing engine behind FineSign — a DocuSign alternative. Stamp drawn/typed signatures and auto-dates onto PDF signature fields, with full page-rotation support. Pure, bring-your-own-storage.",
  "keywords": [
    "esignature",
    "e-signature",
    "docusign",
    "docusign-alternative",
    "pdf",
    "pdf-lib",
    "sign",
    "signature",
    "acroform",
    "self-hosted"
  ],
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "assets/fonts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx ./test/*.test.ts",
    "example:image": "tsx examples/sign-with-image.ts",
    "example:typed": "tsx examples/sign-with-typed-name.ts",
    "example:detect": "tsx examples/detect-fields.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}

{
  "name": "finesign-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "FineSign — open-source e-signature & agreement platform, built on finesign-core.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/core",
    "packages/shared",
    "packages/domain",
    "packages/convert",
    "packages/storage",
    "packages/pades",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "gate": "bash scripts/gate.sh",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint packages --max-warnings 0",
    "boundaries": "bash scripts/check-boundaries.sh",
    "licenses": "node scripts/license-report.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=18"
  }
}

{
  "name": "finesign-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "FineSign — open-source e-signature & agreement platform, built on finesign-core.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/core",
    "packages/shared",
    "packages/domain",
    "packages/convert",
    "packages/storage",
    "packages/pades",
    "packages/server",
    "packages/web",
    "packages/e2e"
  ],
  "scripts": {
    "gate": "bash scripts/gate.sh",
    "dev:api": "npm start --workspace @finesign/server",
    "dev:web": "npm run dev --workspace @finesign/web",
    "e2e": "tsc -b && npm run e2e --workspace @finesign/e2e --",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint packages --max-warnings 0",
    "boundaries": "bash scripts/check-boundaries.sh",
    "licenses": "node scripts/license-report.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=20.12"
  }
}

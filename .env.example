# FineSign server configuration. Copy to `.env` and adjust.
# Only FINESIGN_SENDER_API_KEY is strictly required to boot; everything else has
# a safe default. Values shown are the defaults unless noted.
#
# Who reads this file:
#   - `npm run dev:api` / `npm start -w @finesign/server` load it automatically
#     (from the working directory, then the repo root).
#   - `docker compose` passes it to the server container AND uses it to fill the
#     ${...} placeholders in docker-compose.yml.
# Variables already exported in your shell (or set under `environment:` in
# Compose) take precedence over this file. An empty value (`KEY=`) means "use the
# default", exactly as if the line were absent.
#
# Local development with the web UI — set these four, leave the rest:
#   FINESIGN_SENDER_API_KEY=<openssl rand -hex 32>
#   FINESIGN_DEV_EXPOSE_TOKENS=true
#   FINESIGN_BASE_URL=http://localhost:5173
#   FINESIGN_SIGN_PATH=/s

# ── Required ──────────────────────────────────────────────────────────────────
# Protects the management API (/api/*). Must be >= 16 chars. Generate one with:
#   openssl rand -hex 32
FINESIGN_SENDER_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
# Public origin of the WEB UI — signing links in emails start with this.
#   Local dev (Vite):  http://localhost:5173
#   Docker Compose:    leave empty (Compose uses http://localhost:8080), or set
#                      your public URL, e.g. https://sign.example.com
# Unset outside Compose → http://localhost:4000 (the API itself).
FINESIGN_BASE_URL=
# Path of the human signer page in those links. The web UI's route is /s.
# Docker Compose defaults this to /s. Unset outside Compose → /sign (the API's
# JSON route, only useful if you build your own signer UI).
FINESIGN_SIGN_PATH=
# Where SQLite + blobs live (created if absent). A relative path is resolved
# against the server's working directory (packages/server under `npm -w`).
# Docker Compose always uses /data on the `finesign-data` volume.
FINESIGN_DATA_DIR=./.finesign-data
# Behind a reverse proxy: "true", a hop count, or a trusted IP/CIDR. Controls how
# the real client IP (a legal-record field) is derived from X-Forwarded-For.
# Prefer an explicit CIDR/hop count over "true".
FINESIGN_TRUST_PROXY=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Without SMTP_HOST, emails are LOGGED, not delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FINESIGN_MAIL_FROM=FineSign <no-reply@finesign.local>

# ── Encryption at rest (DG5) ──────────────────────────────────────────────────
# Enables AES-256-GCM encryption of every stored blob. 32 bytes as 64 hex chars
# or base64. Generate one with:  openssl rand -hex 32
# WITHOUT this, documents are stored UNENCRYPTED (a boot warning is logged).
FINESIGN_ENCRYPTION_KEY=
# Retired keys (comma-separated) kept only to decrypt old blobs after a rotation.
FINESIGN_ENCRYPTION_DECRYPT_KEYS=
# Migration ONLY: serve pre-encryption plaintext blobs instead of failing closed.
# Leave unset in normal operation.
FINESIGN_ENCRYPTION_ALLOW_PLAINTEXT_READ=

# ── Cryptographic sealing (PAdES / PKI) ───────────────────────────────────────
# Seal completed PDFs so they verify in Adobe/EU tooling. Provide an org signing
# cert as PKCS#12 (+ passphrase), or use a self-signed DEV seal for local testing.
FINESIGN_SEAL_P12=
FINESIGN_SEAL_PASSPHRASE=
# true → refuse to complete an envelope if sealing is unavailable (fail-closed).
FINESIGN_SEAL_REQUIRED=false
# PAdES level: B-B | B-T | B-LT | B-LTA. Defaults to B-T when a TSA is configured,
# else B-B. B-T and up need a TSA; B-LT/B-LTA also need revocation material.
# The server refuses to BOOT if the level's inputs are missing, rather than
# failing later on the last signer's submission.
FINESIGN_PADES_LEVEL=
# Trust anchors used to VERIFY seals (comma-separated PEM/DER paths). Set this to
# your issuing CA when FINESIGN_SEAL_P12 holds a CA-issued certificate; without
# it the seal certificate is trusted directly.
FINESIGN_SEAL_TRUST_CERTS=
# B-LT/B-LTA revocation material is fetched from the seal certificate's own CRL
# distribution point / AIA OCSP responder. Override only if it publishes neither
# (or the published URL is unreachable from this host).
FINESIGN_SEAL_CRL_URL=
FINESIGN_SEAL_OCSP_URL=
# DEV ONLY: self-signed seal / in-process TSA so long-term levels work offline.
FINESIGN_DEV_SEAL=false
FINESIGN_DEV_TSA=false
# External RFC 3161 timestamp authority (for B-T and up). Pin its cert to let the
# timestamp EXTEND seal validity.
FINESIGN_TSA_URL=
FINESIGN_TSA_CERT=

# ── Webhooks (DG4) ────────────────────────────────────────────────────────────
# Background delivery cadence + limits (defaults shown).
FINESIGN_WEBHOOK_POLL_MS=15000
FINESIGN_WEBHOOK_TIMEOUT_MS=5000
FINESIGN_WEBHOOK_MAX_ATTEMPTS=8
# DEV ONLY: allow webhook endpoints on private/loopback addresses (disables the
# SSRF guard). NEVER set in production.
FINESIGN_WEBHOOK_ALLOW_PRIVATE=false

# ── Expiry sweep (DG3) ────────────────────────────────────────────────────────
FINESIGN_EXPIRY_SWEEP_MS=3600000

# ── Dev conveniences ──────────────────────────────────────────────────────────
# DEV ONLY: expose raw signer links via /api/envelopes/:id/dev-links (so a local
# UI can show them without reading email). NEVER enable in production.
FINESIGN_DEV_EXPOSE_TOKENS=false

# ── Web app (packages/web, build-time) ────────────────────────────────────────
# Base URL of the API the web UI talks to. LEAVE THIS EMPTY unless you really do
# serve the UI on a different origin from the API: empty means same-origin, which
# is what both supported setups use — the Vite dev server proxies /api and /sign
# to :4000, and the Docker web image reverse-proxies them through nginx. Pointing
# it at another origin needs CORS on the server, which is not enabled.
# This is a build-time Vite variable, so it must be set in packages/web/.env (the
# repo-root .env is not read by Vite).
VITE_API_BASE=
